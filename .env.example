# Jira Cloud (REST API v3 / Agile API)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SMA

# GitHub (REST API)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-org-or-user
GITHUB_REPO=your-repo-name

# Model — Claude via Amazon Bedrock (ChatBedrockConverse), not the direct Anthropic API.
# AGENT_MODEL uses the "bedrock:<model-id>" form that initChatModel resolves.
# Use a cross-region inference profile id (the "us."/"eu." prefixed ids) if your
# account requires one for on-demand throughput.
AGENT_MODEL=bedrock:us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS credentials/region for Bedrock. If you already use the AWS SDK default
# credential chain (shared ~/.aws/credentials profile, SSO, instance role, etc.)
# you can omit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY and just set AWS_REGION
# (and AWS_PROFILE if not using "default").
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# Model provider toggle, actually read by src/config.ts: "litellm" (default,
# Claude via a LiteLLM proxy, ANTHROPIC_* vars above), "anthropic" (Claude via
# the direct Anthropic API), or "gemini".
MODEL_PROVIDER=litellm

# Anthropic (only required when MODEL_PROVIDER=anthropic) — talks to
# api.anthropic.com directly with a plain Anthropic API key (no proxy).
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Gemini (only required when MODEL_PROVIDER=gemini) — uses the Gemini API
# directly with an API key, not Vertex AI.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Predictor evaluation (optional) — only needed to run
# scripts/evaluatePredictor.ts or POST /internal/evaluate-predictor
# (src/predictorEvaluation/). Fully separate from the live k-NN predictor;
# nothing else in the app requires these. Get credentials via `modal token
# new` or the Modal dashboard — no credit card required for the free tier.
MODAL_TOKEN_ID=ak-BnTvsOehmLXgpTLENpHpw7
MODAL_TOKEN_SECRET=as-GJq7atm8P5gfBaFR9m6tlh
PREDICTOR_EVAL_SAMPLE_SIZE=500
PREDICTOR_EVAL_MAX_ALGORITHMS=5
PREDICTOR_EVAL_TIMEOUT_MINUTES=15
