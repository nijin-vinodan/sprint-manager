{
  "name": "sprint-manager-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepAgents-based sprint status/risk agent over live Jira + GitHub data",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "server:dev": "tsx watch src/server/index.ts",
    "server:build": "npm run build",
    "server:start": "node dist/server/index.js",
    "dashboard:dev": "next dev",
    "dashboard:build": "next build",
    "dashboard:start": "next start",
    "loadtest": "tsx scripts/loadtest.ts",
    "seed:synthetic-resolution": "tsx scripts/generateSyntheticResolutionHistory.ts",
    "seed:langfuse-dataset": "tsx scripts/seedLangfuseDataset.ts",
    "eval:langfuse": "tsx scripts/runLangfuseExperiment.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-checkpoint": "^1.1.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@langfuse/client": "^5.9.1",
    "@langfuse/langchain": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "deepagents": "^1.11.1",
    "dotenv": "^17.2.4",
    "fastify": "^5.11.0",
    "langchain": "^1.5.0",
    "langsmith": "^0.7.1",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
